---
type NavKey =
  | "home"
  | "about"
  | "education"
  | "experience"
  | "projects"
  | "photography"
  | "travel"
  | "thoughts";

interface Props {
  title?: string;
  description?: string;
  activeNav?: NavKey;
  pageTitle?: string;
  pageDescription?: string;
  wideHeader?: boolean;
}

const {
  title = "Stephen",
  description = "Portfolio site for Stephen.",
  activeNav,
  pageTitle,
  pageDescription,
  wideHeader = false,
} = Astro.props;

const NAV_ITEMS: { key?: NavKey; label: string; href: string }[] = [
  { key: "home", label: "Home", href: "/" },
  { key: "about", label: "About", href: "/about/" },
  { key: "education", label: "Education", href: "/education/" },
  { key: "experience", label: "Experience", href: "/experience/" },
  { key: "projects", label: "Projects", href: "/projects/" },
  { key: "photography", label: "Photography", href: "/photography/" },
  { key: "travel", label: "Travel", href: "/travel/" },
  { key: "thoughts", label: "Thoughts", href: "/thoughts/" },
  { label: "Contact", href: "mailto:stephen@example.com" },
];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);

        const metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme) {
          metaTheme.setAttribute("content", theme === "dark" ? "#0b1220" : "#ffffff");
        }
      })();
    </script>
  </head>

  <body>
    <div class="site">
      <div class="mobile-top">
        <div class="mobile-top-left">
          <img
            src="/images/home/portrait.jpg"
            alt="Stephen portrait"
            width="44"
            height="44"
          />
          <div class="mobile-top-copy">
            <div class="mobile-name">Stephen</div>
            <div class="mobile-role">Strategist &amp; Aspiring Autodidact</div>
          </div>
        </div>

        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          Dark mode
        </button>
      </div>

      <aside>
        <div class="aside-inner">
          <div>
            <div class="avatar">
              <img src="/images/home/portrait.jpg" alt="Stephen portrait" />
            </div>

            <div class="who">
              <div class="name">Stephen</div>
              <a class="role" href="/">Strategist &amp; Aspiring Autodidact</a>
              <div class="loc">Netherlands / United States</div>
            </div>
          </div>

          <nav aria-label="Primary">
            <ul class="sidenav">
              {NAV_ITEMS.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class={item.key && item.key === activeNav ? "active" : ""}
                    aria-current={item.key && item.key === activeNav ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="aside-footer">
            <div class="aside-controls">
              <button
                type="button"
                class="theme-toggle"
                data-theme-toggle
                aria-label="Toggle dark mode"
                title="Toggle dark mode"
              >
                Dark mode
              </button>
            </div>

            <div class="copyright">
              © {new Date().getFullYear()} Stephen ·
              <a href="https://github.com/S2AW" target="_blank" rel="noopener">
                GitHub
              </a>
            </div>
          </div>
        </div>
      </aside>

      <main>
        <div class="content">
          {(pageTitle || pageDescription) && (
            <header class={`page-header ${wideHeader ? "page-header--wide" : ""}`}>
              {pageTitle && <h1 class="page-title">{pageTitle}</h1>}
              {pageDescription && <p class="page-description">{pageDescription}</p>}
            </header>
          )}

          <slot />
        </div>
      </main>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const buttons = document.querySelectorAll("[data-theme-toggle]");
        const metaTheme = document.querySelector('meta[name="theme-color"]');

        function applyTheme(theme) {
          root.setAttribute("data-theme", theme);
          localStorage.setItem("theme", theme);

          if (metaTheme) {
            metaTheme.setAttribute("content", theme === "dark" ? "#0b1220" : "#ffffff");
          }

          buttons.forEach((button) => {
            button.textContent = theme === "dark" ? "Light mode" : "Dark mode";
            button.setAttribute(
              "aria-label",
              theme === "dark" ? "Switch to light mode" : "Switch to dark mode"
            );
            button.setAttribute(
              "title",
              theme === "dark" ? "Switch to light mode" : "Switch to dark mode"
            );
          });
        }

        const currentTheme = root.getAttribute("data-theme") === "dark" ? "dark" : "light";
        applyTheme(currentTheme);

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const nextTheme = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
            applyTheme(nextTheme);
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --sidebar: #f3f5f8;
    --text: #0f141b;
    --muted: #6b7280;
    --accent: #0a67ff;
    --border: #e5e7eb;
    --maxw: 1400px;
    --sidebar-w: 270px;

    --card-border: #111827;
    --surface: #ffffff;
    --surface-muted: #f3f4f6;

    --title: #111827;
    --text-soft: #374151;
    --nav-text: #0f141b;
    --mobile-bar: #ffffff;
    --avatar-ring: #ffffff;

    --toggle-bg: #ffffff;
    --toggle-text: #111827;
    --toggle-border: #d1d5db;
    --toggle-hover: #f9fafb;

    --radius-sm: 10px;
    --radius-md: 14px;
    --radius-lg: 16px;
    --radius-full: 999px;

    --shadow-sm: 0 4px 14px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 6px 22px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 24px rgba(0, 0, 0, 0.06);

    --transition-fast: 160ms ease;
  }

  html[data-theme="dark"] {
    --bg: #0b1220;
    --sidebar: #111827;
    --text: #e5e7eb;
    --muted: #9ca3af;
    --accent: #7cb3ff;
    --border: #253046;

    --card-border: #334155;
    --surface: #111827;
    --surface-muted: #1f2937;

    --title: #f3f4f6;
    --text-soft: #cbd5e1;
    --nav-text: #e5e7eb;
    --mobile-bar: #111827;
    --avatar-ring: #1f2937;

    --toggle-bg: #1f2937;
    --toggle-text: #f3f4f6;
    --toggle-border: #334155;
    --toggle-hover: #273449;

    --shadow-sm: 0 4px 14px rgba(0, 0, 0, 0.25);
    --shadow-md: 0 6px 22px rgba(0, 0, 0, 0.28);
    --shadow-lg: 0 10px 24px rgba(0, 0, 0, 0.3);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  }

  body {
    min-height: 100dvh;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  a:hover {
    text-decoration: underline;
  }

  .site {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100dvh;
  }

  @media (min-width: 800px) {
    .site {
      grid-template-columns: var(--sidebar-w) 1fr;
    }
  }

  aside {
    background: var(--sidebar);
    border-right: 1px solid var(--border);
  }

  .aside-inner {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 28px 22px;
    gap: 18px;
    max-width: var(--sidebar-w);
    margin: 0 auto;
  }

  .aside-footer {
    display: grid;
    gap: 10px;
  }

  .aside-controls {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .theme-toggle {
    appearance: none;
    border: 1px solid var(--toggle-border);
    background: var(--toggle-bg);
    color: var(--toggle-text);
    border-radius: var(--radius-full);
    padding: 8px 14px;
    font: 600 0.9rem/1 Inter, system-ui, sans-serif;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .theme-toggle:hover {
    background: var(--toggle-hover);
    text-decoration: none;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .avatar {
    width: 160px;
    height: 160px;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 2px solid var(--avatar-ring);
    box-shadow: var(--shadow-md);
    margin: 0 auto;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .who {
    text-align: center;
    margin-top: 8px;
  }

  .name {
    font: 700 1.35rem/1.2 "Playfair Display", Georgia, serif;
    color: var(--title);
  }

  .role {
    font-size: 0.9rem;
    color: var(--accent);
    display: inline-block;
    margin-top: 4px;
  }

  .loc {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .sidenav {
    list-style: none;
    margin: 18px 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .sidenav a {
    color: var(--nav-text);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .sidenav a.active,
  .sidenav a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .copyright {
    color: var(--muted);
    font-size: 0.8rem;
    text-align: center;
  }

  main {
    display: grid;
    align-content: start;
    min-width: 0;
  }

  .content {
    width: 100%;
    max-width: var(--maxw);
    margin-left: 0;
    margin-right: auto;
    padding: clamp(12px, 2vw, 28px);
    padding-left: clamp(12px, 2vw, 28px);
  }

  .mobile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px;
    border-bottom: 1px solid var(--border);
    background: var(--mobile-bar);
  }

  .mobile-top-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .mobile-top img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: var(--radius-full);
  }

  .mobile-top-copy {
    display: grid;
    gap: 2px;
  }

  .mobile-name {
    font: 600 1.05rem/1 Inter, system-ui, sans-serif;
    color: var(--title);
  }

  .mobile-role {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .page-header {
    margin: 0 0 18px;
    max-width: 65ch;
  }

  .page-header--wide {
    max-width: none;
  }

  .page-title {
    margin: 0 0 4px;
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.9rem, 3.7vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: 0.03em;
    color: var(--title);
  }

  .page-description {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-soft);
    max-width: inherit;
  }

  .section-title,
  h2.section-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.8rem;
    margin: 2rem 0 1rem;
    color: var(--title);
  }

  .card {
    border: 2px solid var(--card-border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .chip {
    display: inline-block;
    border: 1px solid var(--border);
    padding: 6px 10px;
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .chip:hover {
    background: var(--surface-muted);
    text-decoration: none;
  }

  @media (min-width: 800px) {
    .mobile-top {
      display: none;
    }
  }

  @media (max-width: 959px) {
    aside {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .aside-inner {
      position: static;
      height: auto;
      padding: 16px;
    }
  }
</style>