---
import MainLayout2 from "../../layouts/mainlayout2.astro";

const SITE_TITLE = "Stephen — Photography";
const SITE_DESCRIPTION = "Camera gear, plus albums I add to over time.";

const CAMERA_URL = "https://example.com/olympus-om5";
const CAMERA_IMG_SRC = "/images/photography/gear/om-5.jpg";
---

<MainLayout2
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  activeNav="photography"
  pageTitle="Photography"
  pageDescription="Camera gear, plus albums I add to over time."
>
  <section class="gear-card">
    <div class="gear-head">
      <h2 class="gear-title">Camera Gear</h2>
    </div>
    <div class="gear-body">
      <div class="gear-grid">
        <div class="gear-item">
          <b>Camera Bodies</b>
          <div>Olympus OM-5</div>
          <div>Various iPhones</div>
        </div>

        <div class="gear-item">
          <b>Lenses</b>
          <div>Olympus M.Zuiko Digital 14–42mm f/3.5–5.6 EZ</div>
          <div>Olympus M.Zuiko Digital ED 75–300mm f/4.8–6.7</div>
        </div>

        <div class="gear-item image-item" style="border: none; padding: 0;">
          <a
            class="camera-link"
            href="https://explore.omsystem.com/gb/en/om-5-black-12-45mm-pro-lens-kit"
            target="_blank"
            rel="noopener"
            style="border: none; box-shadow: none;"
          >
            <img
              class="camera-img"
              src="/images/photography/omd5.jpg"
              alt="Olympus OM-5 camera"
              style="width: 150px; height: auto; border-radius: 6px; display: block; margin-left: auto; margin-right: auto;"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <h2 class="section-title">Albums</h2>

  <div class="grid">
    <article class="card photo-card">
      <a href="/photography/birds">
        <img
          class="cover"
          src="/images/photography/albums/birds/cover.jpg"
          alt="Birds"
        />
      </a>

      <div class="body">
        <div class="title">Birds</div>
        <div class="subtitle">Birds...</div>
      </div>
    </article>

    <article class="card photo-card">
      <a href="/photography/coffee">
        <img
          class="cover"
          src="/images/photography/coffee/7.jpg"
          alt="Coffee cover"
        />
      </a>
      <div class="body">
        <div class="title">Coffee</div>
        <div class="subtitle">Caffeine rituals & special brews.</div>
      </div>
    </article>

    <article class="card photo-card">
      <a href="/photography/dogs">
        <img
          class="cover"
          src="/images/photography/albums/dogs/cover.jpg"
          alt="Dogs cover"
        />
      </a>
      <div class="body">
        <div class="title">Dogs</div>
        <div class="subtitle">Good pups doing their thing.</div>
      </div>
    </article>

    <article class="card photo-card">
      <a href="/photography/natural-scenery">
        <img
          class="cover"
          src="/images/photography/albums/natural-scenery/cover.jpg"
          alt="Natural scenery cover"
        />
      </a>
      <div class="body">
        <div class="title">Natural Scenery</div>
        <div class="subtitle">Landcapes, coastlines, and skies.</div>
      </div>
    </article>

    <article class="card photo-card">
      <a href="/photography/wildlife">
        <img
          class="cover"
          src="/images/photography/albums/wildlife/cover.jpg"
          alt="Wildlife cover"
        />
      </a>
      <div class="body">
        <div class="title">Wildlife</div>
        <div class="subtitle">Animals, mostly in the wild.</div>
      </div>
    </article>
  </div>

  <style>
    .gear-card {
      border: 2px solid var(--card-border);
      border-radius: 14px;
      background: var(--surface);
      overflow: hidden;
    }

    .gear-head {
      padding: 14px;
      border-bottom: 1px solid var(--border);
    }

    .gear-title {
      margin: 0;
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.4rem;
      color: var(--title);
    }

    .gear-body {
      padding: 12px;
      color: var(--text);
    }

    .gear-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(1, 1fr);
    }

    @media (min-width: 800px) {
      .gear-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .gear-item {
      border: 1px dashed var(--border);
      border-radius: 10px;
      padding: 10px;
      color: var(--text);
      background: var(--surface);
    }

    .gear-item b {
      display: block;
      margin-bottom: 6px;
      color: var(--title);
    }

    .image-item {
      display: grid;
      gap: 10px;
    }

    .camera-link {
      display: block;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .camera-link:hover {
      box-shadow: var(--shadow-md);
    }

    .camera-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      aspect-ratio: 4 / 3;
      background: var(--surface-muted);
    }

    .grid {
      display: grid;
      gap: 18px;
      grid-template-columns: repeat(1, 1fr);
    }

    @media (min-width: 720px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (min-width: 1100px) {
      .grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }

    .photo-card {
      overflow: hidden;
      background: var(--surface);
      border: 2px solid var(--card-border);
      border-radius: 14px;
    }

    .cover {
      aspect-ratio: 16 / 10;
      width: 100%;
      object-fit: cover;
      background: var(--surface-muted);
    }

    .body {
      padding: 10px;
      color: var(--text);
    }

    .title {
      font-weight: 700;
      color: var(--title);
    }

    .subtitle {
      color: var(--muted);
      font-size: 0.9rem;
    }
  </style>
</MainLayout2>