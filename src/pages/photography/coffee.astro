---
import MainLayout2 from "../../layouts/mainlayout2.astro";

const SITE_TITLE = "Stephen — Coffee Photography";
const SITE_DESCRIPTION = "Coffee-focused photos you can click through.";

const IMAGES = [
  "/images/photography/coffee/1.jpg",
  "/images/photography/coffee/2.jpg",
  "/images/photography/coffee/3.jpg",
  "/images/photography/coffee/4.jpg",
  "/images/photography/coffee/5.jpg",
  "/images/photography/coffee/6.jpg",
  "/images/photography/coffee/7.jpg",
];
---

<MainLayout2
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  activeNav="photography"
  pageTitle="Coffee"
  pageDescription="A bitter, aromatic sacrifice offered each morning to appease the god of Productivity; valued chiefly for its ability to transform human reluctance into jittery compliance, and afternoons into tolerable rumors of alertness."
  wideHeader={true}
>
  <a href="/photography/" class="back-link">
    <span>←</span> Back to albums
  </a>

  <div class="gallery-grid" id="coffee-gallery">
    {IMAGES.map((src, index) => (
      <button
        type="button"
        class="thumb"
        data-index={index}
        aria-label={`Open coffee photo ${index + 1}`}
      >
        <img src={src} alt={`Coffee photo ${index + 1}`} loading="lazy" />
        <div class="thumb-overlay">
          <div class="thumb-badge">View</div>
        </div>
      </button>
    ))}
  </div>

  <div class="lightbox-backdrop" id="lightbox-backdrop" aria-hidden="true">
    <div class="lightbox-frame">
      <div class="lightbox-image-wrap">
        <img id="lightbox-image" src="" alt="" />
        <div class="lightbox-controls">
          <button
            type="button"
            class="lightbox-arrow"
            id="lightbox-prev"
            aria-label="Previous photo"
          >
            ‹
          </button>
          <button
            type="button"
            class="lightbox-arrow"
            id="lightbox-next"
            aria-label="Next photo"
          >
            ›
          </button>
        </div>
      </div>

      <div class="lightbox-top">
        <div id="lightbox-index">1 / 1</div>
        <button
          type="button"
          class="pill-button"
          id="lightbox-close"
          aria-label="Close viewer"
        >
          Close
        </button>
      </div>
    </div>
  </div>

  <style>
    .back-link {
      font-size: 0.9rem;
      margin-bottom: 8px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text-soft);
      text-decoration: none;
    }

    .back-link:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .subtext {
      color: var(--text-soft);
      margin: 8px 0 22px;
      font-size: 1.02rem;
      max-width: 70ch;
    }

    .gallery-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      margin-top: 20px;
    }

    .thumb {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      border: 1px solid var(--border);
      background: var(--surface);
      padding: 0;
    }

    .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      aspect-ratio: 4 / 5;
      transition: transform 0.15s ease-out;
      background: var(--surface-muted);
    }

    .thumb:hover img {
      transform: scale(1.03);
    }

    .thumb-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent);
      opacity: 0;
      transition: opacity 0.15s ease-out;
    }

    .thumb:hover .thumb-overlay {
      opacity: 1;
    }

    .thumb-badge {
      position: absolute;
      left: 8px;
      bottom: 8px;
      padding: 4px 8px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.85);
      color: #f9fafb;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .lightbox-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.9);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 16px;
      z-index: 40;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.16s ease-out;
    }

    .lightbox-backdrop.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-frame {
      border-radius: 16px;
      padding: 12px;
      background: #020617;
      border: 1px solid rgba(148, 163, 184, 0.7);
      box-shadow: 0 22px 60px rgba(0, 0, 0, 0.7);
    }

    .lightbox-image-wrap {
      position: relative;
      border-radius: 10px;
      background: #020617;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: visible;
    }

    .lightbox-image-wrap img {
      display: block;
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: calc(100vh - 200px);
      object-fit: contain;
    }

    .lightbox-controls {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 6px;
      pointer-events: none;
    }

    .lightbox-arrow {
      width: 42px;
      height: 42px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.8);
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.9));
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #e5e7eb;
      pointer-events: auto;
    }

    .lightbox-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 6px;
      color: #e5e7eb;
      font-size: 0.85rem;
    }

    .pill-button {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: linear-gradient(90deg, #111827, #020617);
      color: #f9fafb;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 6px 10px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }
  </style>

  <script is:inline>
    (() => {
      const backdrop = document.getElementById("lightbox-backdrop");
      const imgEl = document.getElementById("lightbox-image");
      const indexEl = document.getElementById("lightbox-index");
      const prevBtn = document.getElementById("lightbox-prev");
      const nextBtn = document.getElementById("lightbox-next");
      const closeBtn = document.getElementById("lightbox-close");
      const thumbButtons = Array.from(
        document.querySelectorAll("#coffee-gallery .thumb")
      );

      if (!backdrop || !imgEl || !indexEl || thumbButtons.length === 0) {
        return;
      }

      const images = thumbButtons
        .map((btn) => {
          const img = btn.querySelector("img");
          return img ? img.getAttribute("src") : null;
        })
        .filter(Boolean);

      let currentIndex = 0;

      function updateLightbox() {
        const src = images[currentIndex];
        if (!src) return;
        imgEl.src = src;
        imgEl.alt = "Coffee photo " + (currentIndex + 1);
        indexEl.textContent = (currentIndex + 1) + " / " + images.length;
      }

      function openAt(index) {
        if (!images.length) return;
        currentIndex = index;
        updateLightbox();
        backdrop.classList.add("is-open");
        backdrop.setAttribute("aria-hidden", "false");
      }

      function closeBox() {
        backdrop.classList.remove("is-open");
        backdrop.setAttribute("aria-hidden", "true");
      }

      function showNext() {
        currentIndex = (currentIndex + 1) % images.length;
        updateLightbox();
      }

      function showPrev() {
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        updateLightbox();
      }

      thumbButtons.forEach((btn, index) => {
        btn.addEventListener("click", () => openAt(index));
      });

      prevBtn?.addEventListener("click", showPrev);
      nextBtn?.addEventListener("click", showNext);
      closeBtn?.addEventListener("click", closeBox);

      backdrop.addEventListener("click", (event) => {
        if (event.target === backdrop) {
          closeBox();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (!backdrop.classList.contains("is-open")) return;
        if (event.key === "Escape") {
          closeBox();
        } else if (event.key === "ArrowRight") {
          showNext();
        } else if (event.key === "ArrowLeft") {
          showPrev();
        }
      });
    })();
  </script>
</MainLayout2>