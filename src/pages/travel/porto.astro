---
const SITE_TITLE = "Stephen — Porto, Portugal";
const SITE_DESCRIPTION = "Personal travel notes and photos from a week in Porto, Portugal.";

const NAV = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Education", href: "/education/" },
  { label: "Experience", href: "/experience/" },
  { label: "Projects", href: "/projects/" },
  { label: "Photography", href: "/photography/" },
  { label: "Travel", href: "/travel/", active: true },
  { label: "Thoughts", href: "/thoughts/" },
  { label: "Contact", href: "mailto:stephen@example.com" },
];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="icon" href="/favicon.ico" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg:#fff; --sidebar:#f3f5f8; --text:#0f141b; --muted:#6b7280; --accent:#0a67ff;
        --border:#e5e7eb; --maxw:1400px; --sidebar-w:270px;
      }

      *{box-sizing:border-box}
      html,body{
        margin:0;
        padding:0;
        background:var(--bg);
        color:var(--text);
        font:16px/1.6 Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
      }
      img{max-width:100%;display:block}
      a{color:var(--accent);text-decoration:none}
      a:hover{text-decoration:underline}

      .site{display:grid;grid-template-columns:1fr;min-height:100dvh}
      @media(min-width:800px){
        .site{grid-template-columns:var(--sidebar-w) 1fr}
      }

      aside{
        background:var(--sidebar);
        border-right:1px solid var(--border);
      }
      .aside-inner{
        position:sticky;
        top:0;
        height:100dvh;
        display:grid;
        grid-template-rows:auto 1fr auto;
        padding:28px 22px;
        gap:18px;
        max-width:var(--sidebar-w);
        margin:0 auto;
      }
      .avatar{
        width:160px;
        height:160px;
        border-radius:999px;
        overflow:hidden;
        border:2px solid #fff;
        box-shadow:0 6px 22px rgba(0,0,0,.06);
        margin:0 auto;
      }
      .avatar img{
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:50% 35%;
      }
      .who{text-align:center;margin-top:8px}
      .name{
        font:700 1.35rem/1.2 "Playfair Display",Georgia,serif;
        color:#111827;
      }
      .role{font-size:.9rem;color:var(--accent)}
      .loc{color:var(--muted);font-size:.85rem}

      .sidenav{
        list-style:none;
        margin:18px 0;
        padding:0;
        display:grid;
        gap:10px;
      }
      .sidenav a{
        color:#0f141b;
        font-weight:600;
      }
      .sidenav a.active,
      .sidenav a:hover{
        color:var(--accent);
      }

      .copyright{
        color:var(--muted);
        font-size:.8rem;
      }

      main{
        display:grid;
        align-content:start;
      }
      .content{
        width:100%;
        max-width:none;
        margin:0;
        padding: clamp(12px, 2vw, 28px);
        padding-left: clamp(12px, 2vw, 28px);
      }

      .breadcrumb{
        font-size:.85rem;
        color:var(--muted);
        margin-bottom:2px;
      }
      .breadcrumb a{
        color:var(--muted);
      }
      .breadcrumb a:hover{
        color:var(--accent);
      }

      .headline{
        font-family:"Playfair Display",Georgia,serif;
        font-size:clamp(2.4rem,4.2vw,3.4rem);
        line-height:1.08;
        margin:8px 0 4px;
      }
      .subtext{
        color:#374151;
        margin:4px 0 18px;
        font-size:1.03rem;
      }

      .hero-layout{
        display:grid;
        gap:18px;
        grid-template-columns:1fr;
        margin-top:12px;
        margin-bottom:26px;
      }
      @media(min-width:900px){
        .hero-layout{
          grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);
          align-items:start;
        }
      }

      .hero-image-wrap{
        border-radius:16px;
        overflow:hidden;
        border:none;
        background:none;
        padding:0;
      }

      .hero-image{
        width:100%;
        height:100%;
        object-fit:cover;
        aspect-ratio:16/9;
      }

      .hero-meta{
        border-radius:16px;
        border:1px solid var(--border);
        background:#fff;
        padding:14px 16px;
      }
      .hero-meta h2{
        margin:0 0 10px;
        font-family:"Playfair Display",Georgia,serif;
        font-size:1.2rem;
      }
      .meta-grid{
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:10px;
        font-size:.9rem;
      }
      .meta-label{
        color:var(--muted);
        font-size:.8rem;
        text-transform:uppercase;
        letter-spacing:.05em;
      }
      .meta-value{
        font-weight:500;
      }

      .section{
        margin-bottom:24px;
      }
      .section-wide{
        margin-bottom:24px;
      }
      .section h2{
        font-family:"Playfair Display",Georgia,serif;
        font-size:1.5rem;
        margin:0 0 8px;
        color:#111827;
      }
      .section p{
        margin:0 0 10px;
      }
      .section ul{
        margin:6px 0 10px 1.2rem;
        padding:0;
      }
      .section li{
        margin-bottom:4px;
      }

      .two-column{
        display:grid;
        grid-template-columns:1fr;
        gap:18px;
      }

      .note-list{
        list-style:disc;
        margin:6px 0 0 1.2rem;
        padding:0;
      }

      .callout{
        border-radius:12px;
        border:1px dashed #cbd5e1;
        padding:10px 12px;
        background:#f9fafb;
        font-size:.92rem;
      }

      /* ============================= */
      /* IMAGE SIZING WITH --img-scale */
      /* ============================= */

      /* Generic image wrapper – used everywhere */
      .img-wrap{
        --img-scale: 0.8;           /* default, overridden inline */
        display: flex;
        flex-direction: column;
        align-items: center;        /* centers the scaled image in the grid cell */
      }

      /* image scales relative to the grid cell width */
      .img-wrap img{
        width: calc(100% * var(--img-scale));
        max-width: 100%;
        height: auto;
        display: block;
        border-radius: 14px;
        border: 1px solid var(--border);
        background:#f3f4f6;
        object-fit: cover;
      }

      /* caption is forced to the same scaled width as the image */
      .img-wrap .caption{
        width: calc(100% * var(--img-scale));
        font-size: .85rem;
        color: var(--muted);
        margin-top: 6px;
        text-align: left;
        overflow-wrap: anywhere;
      }

      /* Single-image blocks */
      .photo-block {
        margin: 22px 0;
      }

      .caption {
        font-size: .85rem;
        color: var(--muted);
        margin-top: 6px;
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
      }

      .photo-block .img-wrap .caption{
        width: calc(100% * var(--img-scale)) !important;
        max-width: none !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        text-align: left;
        overflow-wrap: anywhere;
      }

      /* Side-by-side rows */
      .photo-row {
        display: grid;
        gap: 16px;
        margin: 26px 0;
      }

      .photo-row--2 {
        grid-template-columns: repeat(2, 1fr);
      }

      .photo-row--3 {
        grid-template-columns: repeat(3, 1fr);
      }

      @media(max-width:959px){
        aside{
          border-right:none;
          border-bottom:1px solid var(--border);
        }
        .aside-inner{
          position:static;
          height:auto;
          padding:16px;
        }
        .photo-row{
          grid-template-columns:1fr !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="site">
      <aside>
        <div class="aside-inner">
          <div>
            <div class="avatar">
              <img src="/images/home/portrait.jpg" alt="Stephen portrait" />
            </div>
            <div class="who">
              <div class="name">Stephen</div>
              <a class="role" href="/">Strategist &amp; Aspiring Autodidact</a>
              <div class="loc">Netherlands / United States</div>
            </div>
          </div>

          <nav>
            <ul class="sidenav">
              {NAV.map((n) => (
                <li>
                  <a class={n.active ? "active" : ""} href={n.href}>
                    {n.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="copyright">
            © {new Date().getFullYear()} Stephen ·{" "}
            <a href="https://github.com/S2AW" target="_blank" rel="noopener">
              GitHub
            </a>
          </div>
        </div>
      </aside>

      <main>
        <div class="content">
          <div class="breadcrumb">
            <a href="/travel/">Travel</a> / Porto, Portugal
          </div>

          <h1 class="headline">Porto, Portugal</h1>
          <p class="subtext">
            A week in a historic, industrial port city with strong wine, sweeping river views, and an emerging tourism scene that still feels distinctly local.
          </p>

          <section class="hero-layout">
            <div class="hero-image-wrap">
              <!-- 1 – overlooking porto (cover) -->
              <div class="img-wrap" style="--img-scale:1.0;">
                <img
                  class="hero-image"
                  src="/images/travel/porto/1.jpg"
                  alt="Overlooking the city of Porto and the Douro River"
                />
              </div>
            </div>
            <aside class="hero-meta">
              <h2>Trip Snapshot</h2>
              <div class="meta-grid">
                <div>
                  <div class="meta-label">Visited</div>
                  <div class="meta-value">July, ~1 week</div>
                </div>
                <div>
                  <div class="meta-label">From</div>
                  <div class="meta-value">Amsterdam (AMS → OPO)</div>
                </div>
                <div>
                  <div class="meta-label">Region</div>
                  <div class="meta-value">Iberian Peninsula</div>
                </div>
                <div>
                  <div class="meta-label">Why Go</div>
                  <div class="meta-value">Wine, river, sunsets, value</div>
                </div>
              </div>
            </aside>
          </section>

          <!-- Overview -->
          <section class="section">
            <h2>Overview</h2>
            <p>
              I visited Porto, Portugal in July for about a week. I flew from Amsterdam Schiphol and landed at Francisco Sá Carneiro Airport (OPO). Porto sits on the Iberian Peninsula and often flies under the radar relative to nearby destinations in Spain, southern Portugal, France, or Italy. I initially visited simply to add Portugal to my travel map, but I found a city offering strong tourist value: striking views, excellent port wine, historic buildings, scenic river cruises, and prices lower than many Western European hotspots.
            </p>
            <p>
              Porto is Portugal’s second-largest city and the capital of the northern region, functioning as a long-standing industrial and commercial center. The city feels industrial and aging, but with a visible student population and a tourism sector that is clearly growing. Architecturally, it ranges from medieval to modern, spanning numerous styles. Much of Porto is built on high ground overlooking the northern bank of the Douro River estuary, and its historic center was designated a UNESCO World Heritage Site in 1996.
            </p>
            <p>
              The overall vibe is welcoming and relaxed, with high English proficiency, affordable rideshares, and impressive sunsets over the Atlantic.
            </p>

            <!-- 2 & 3 – general understanding porto -->
            <div class="photo-row photo-row--2">
              <div class="img-wrap" style="--img-scale:0.5;">
                <img
                  src="/images/travel/porto/2.jpg"
                  alt="Castle in Porto flying the Portuguese flag"
                />
                <div class="caption">Castle in Porto flying the Portuguese flag.</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.5;">
                <img
                  src="/images/travel/porto/3.jpg"
                  alt="Cityscape of Porto"
                />
                <div class="caption">Overlooking Porto's cityscape.</div>
              </div>
            </div>

            
          </section>

          <!-- Understand -->
          <section class="section">
            <h2>Understand</h2>
            <p>
              Porto reflects an important maritime legacy. 
              Its roots trace back to the Age of Discovery, when the city embodied grit, commerce, and shipbuilding rather than courtly prestige. 
              That legacy still shows: Porto historically supplied fleets, merchants, and labor, earning a reputation as a working city shaped more by trade than nobility.
            </p>
            <p>
              The culture felt warm, friendly, and Mediterranean-influenced despite the Atlantic location. 
              Locals often describe the city as proud, resilient, and no-nonsense an identity reinforced by its history of resistance and its nickname, "Cidade Invicta" (the undefeated city). 
              There is a palpable student energy, and street-performing university groups add character and movement to public spaces.
            </p>
            <p>
              Languages encountered included Portuguese, Spanish, and English. 
              English-speaking visitors should be able to navigate comfortably.
            </p>
            <p>
              Weather in July was warm and sunny, roughly 21 to 26°C (70 to 80°F), with no rain and mostly clear skies. 
              Despite the Atlantic influence, conditions were ideal for vineyard tours, sunsets, and river cruises. 
              Summer feels like the optimal season to experience Porto at its most relaxed and visually striking.
            </p>
            
          </section>

          <!-- Getting in & Around -->
          <section class="section">
            <h2>Gettting In &amp; Getting Around</h2>
            <p>
              I flew into Francisco Sá Carneiro Airport (OPO). 
              It was smaller than expected but easy to navigate. 
              Arrival was smooth for an experienced traveler, with no sense of congestion despite the airport’s growing role as Portugal’s secondary international hub. 
              Located roughly 15 km from the city center, it handles a high volume of passengers relative to Porto’s size, driven by increasing tourist demand and the region’s economic importance. 
              I took an Uber from the airport; rideshares in Porto were significantly cheaper than in many Western European cities, making airport transfers straightforward and cost-effective. 
              The Metro line E connects the airport to the city center.
            </p>
            <p>
              I relied mainly on walking and Uber around tourist areas. 
              Navigation apps make walking straightforward, but the hills are not trivial. 
              Much of Porto is built into steep, uneven terrain overlooking the Douro River, making it physically demanding to explore on foot but visually rewarding. 
              Even if you are relatively fit, expect some effort. 
              Mobility-limited travelers should factor in the gradients and prioritize transit options.
            </p>
            <p>
              Driving would be difficult and frustrating in central Porto, especially in tourist-heavy neighborhoods with narrow streets and irregular layouts, so I avoided renting a car altogether. 
              Walking works well for short distances despite the elevation, and rideshare filled the gaps efficiently and affordably.
            </p>
            <p>
              Public transit options exist, including trams and a modern light-rail system operated by Porto Metro, but I used them sparingly. 
              The metro is efficient for longer point-to-point trips, though it does not serve every tourist area equally, and announcements are primarily in Portuguese.
            </p>  

            <p>
              Overall, a combination of walking and rideshare was the most convenient way to get around, balancing flexibility with the city’s challenging terrain.
            </p>
            <p>
              Depending on your trip itinerary and interests, the Porto Card may be worthwile.  
              <a href="https://visitporto.travel/en-GB/porto-card" target="_blank" rel="noopener noreferrer">
                Porto.CARD
              </a>
               is Porto’s official city pass, providing free access to selected museums and public transport as well as discounts on certain attractions, services, monuments, and tours for 1-4 days.
            </p>


            <!-- 4, 5, 6 – getting around challenges -->
            <div class="photo-row photo-row--3">
              <div class="img-wrap" style="--img-scale:0.7;">
                <img
                  src="/images/travel/porto/4.jpg"
                  alt="Crowded streets in central Porto"
                />
                <div class="caption">Crowded streets in central Porto.</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.7;">
                <img
                  src="/images/travel/porto/5.jpg"
                  alt="Steep stairs in Porto"
                />
                <div class="caption">Steep stairs showing how vertical the city can be.</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.7;">
                <img
                  src="/images/travel/porto/6.jpg"
                  alt="Busy pedestrian areas with shops and cafes"
                />
                <div class="caption">Busy pedestrian areas with shops and cafes.</div>
              </div>
            </div>

            
          </section>

          <!-- See & Do -->
          <section class="section">
            <h2>See &amp; Do</h2>

            <!-- cristal palace gardens -->
            <p>
              <a href="https://ambiente.cm-porto.pt/parques-e-jardins/jardins-do-palacio-de-cristal" target="_blank" rel="noopener noreferrer">
                <strong>Jardins do Palácio de Cristal</strong>
              </a>
               - A large public garden and park in Porto, known for its beautifully landscaped grounds and sweeping panoramic views over the Douro River. 
              One of the city’s most popular green spaces.
              I only spent about an hour here during a longer walk and immediately wished I had planned more time. 
              The gardens were stunning, the views of Porto’s bridges were spectacular, the peacocks were endlessly entertaining, and the fact that it was all free made it even better. 
              If I were to redo the trip, I would grab lunch from a nearby café or market and have a picnic here. 
              This felt like a true must-see.
            </p>

            <div class="photo-row photo-row--3">
              <div class="img-wrap" style="--img-scale:0.56;">
                <img
                  src="/images/travel/porto/7.jpg"
                  alt="Terrace in the gardens overlooking the Douro"
                />
                <div class="caption">Terrace in the gardens overlooking the Douro.</div>
              </div>
              <div class="img-wrap" style="--img-scale:1.0;">
                <img
                  src="/images/travel/porto/8.jpg"
                  alt="Flowers in bloom inside the gardens"
                />
                <div class="caption">Flowers in bloom inside the gardens.</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.56;">
                <img
                  src="/images/travel/porto/9.jpg"
                  alt="Peacock wandering through the grounds"
                />
                <div class="caption">Peacock wandering through the grounds.</div>
              </div>
            </div>

            <!-- Porto Cathedral -->
            <p>
              <a href="https://www.diocese-porto.pt/pt/catedral-do-porto/" target="_blank" rel="noopener noreferrer">
                <strong>Sé do Porto (Porto Cathedral)</strong>
              </a>
               - One of Porto’s oldest and most significant monuments, with construction beginning in the 12th century. 
               Located on a hilltop overlooking the old city and the Douro River, it features a striking Gothic cloister adorned with traditional blue-and-white azulejo tiles.
               Porto is filled with churches, many of which charge an entry fee, and after a while they can start to blend together. 
               If you only choose one, this should be it. 
               Sé do Porto offers not just ornate relics, but also tiled cloisters, multiple levels to explore, a pavilion, and an open square outside with excellent city views. 
               Many churches are worth visiting, but this one stood out the most.
            </p>
            <div class="photo-row photo-row--2">
              <div class="img-wrap" style="--img-scale:0.5;">
                <img
                  src="/images/travel/porto/10.jpg"
                  alt="Blue-and-White azulejo tiles"
                />
                <div class="caption">Blue-and-White azulejo tiles.</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.50;">
                <img
                  src="/images/travel/porto/11.jpg"
                  alt="Altar area in the cathedral"
                />
                <div class="caption">Altar area in the cathedral.</div>
              </div>
            </div>

            <!-- Mercado do Bolhão -->
            <p>
              <a href="https://mercadobolhao.pt/" target="_blank" rel="noopener noreferrer">
                <strong>Mercado do Bolhão</strong>
              </a>
               - Porto’s most famous traditional market, opened in 1914. 
               Known for fresh produce, fish, meat, flowers, and a wide variety of traditional Portuguese foods.
               The vendors reminded me of a Mediterranean take on Reading Terminal Market—fruit, fish, meat, smoothies, candy, baked goods, and more packed into a lively space. 
               It is a great place to wander and pick up breakfast, lunch, or a midday snack. 
               Just be aware that there are very few places to sit or even stand and eat within the market.
            </p>
            <div class="photo-row photo-row--2">
              <div class="img-wrap" style="--img-scale:0.5;">
                <img
                  src="/images/travel/porto/12.jpg"
                  alt="Entrance to the market square"
                />
                <div class="caption">Entrance to the market square</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.50;">
                <img
                  src="/images/travel/porto/13.jpg"
                  alt="Fresh fruit and produce"
                />
                <div class="caption">Fresh fruit and produce.</div>
              </div>
            </div>

            <!-- Serralves Museum Gardens -->
            <p>
              <a href="https://www.serralves.pt/" target="_blank" rel="noopener noreferrer">
                <strong>Serralves Museum Gardens</strong>
              </a>
              - Established in 1989 as a non-profit cultural foundation, Serralves combines a contemporary art museum, expansive landscaped gardens, and the historic Casa de Serralves.
              This was easily the strangest stop of the trip, mostly because I didn’t quite know what to expect. 
              I was a bit surprised by the entry fee (higher than anticipated), though not enough to stop me from going in. 
              Inside, you move between beautiful gardens, modern art installations, and even a small farm or ranch. 
              It can be jarring at times, like encountering giant modern sculptures in front of an otherwise serene pool. 
              It is also a bit of a journey outside Porto proper. 
              I took an Uber there and walked back along the coast through Foz, which was long but nice. 
              Worth visiting if you have extra time, but not a must-see.
            </p>

            <div class="photo-row photo-row--2">
              <div class="img-wrap" style="--img-scale:0.5;">
                <img
                  src="/images/travel/porto/14.jpg"
                  alt="Pink House and monument"
                />
                <div class="caption">Pink House and monument.</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.5;">
                <img
                  src="/images/travel/porto/15.jpg"
                  alt="Flower and bee from the Museum gardens"
                />
                <div class="caption">Flower and bee from the Museum gardens.</div>
              </div>
            </div>

            <!-- Stock Palace --> 
            <p>
              <a href="https://palaciodabolsa.com/en/intro/" target="_blank" rel="noopener noreferrer">
                <strong>Palácio da Bolsa (Stock Exchange Palace)</strong>
              </a>
              - A 19th-century building in Porto’s historic center, originally constructed to house the city’s Commercial Association. 
              It served as Porto’s stock exchange and commercial court and is renowned for its lavish interiors, especially the Arab Room inspired by Moorish design. 
              Still used today for official ceremonies, conferences, and cultural events.
              This was one of my favorite visits. 
              The palace is stunning, rich with history, and I was genuinely disappointed when the guided tour ended. 
              I wanted more time to wander the halls, learn about the building's evolving role through time, and better understand the events that took place here. 
              Porto’s seafaring, mercantile, and industrial history all seem to converge in this building. 
              Tours are scheduled in various languages at various times, so make sure to book in advance.
              This is absolutely a must-see.
            </p>

            <div class="photo-row photo-row--2">
              <div class="img-wrap" style="--img-scale:1.0;">
                <img
                  src="/images/travel/porto/16.jpg"
                  alt="Stairs inside the Porto stock palace"
                />
                <div class="caption">Staircase inside Palácio da Bolsa.</div>
              </div>
              <div class="img-wrap" style="--img-scale:0.57;">
                <img
                  src="/images/travel/porto/17.jpg"
                  alt="Golden room in the Porto stock palace"
                />
                <div class="caption">The golden room of the Stock Palace.</div>
              </div>
            </div>

            <!-- Foz do Douro -->
            <p>
              <a href="https://en.wikipedia.org/wiki/Foz_do_Douro" target="_blank" rel="noopener noreferrer">
                <strong>Foz do Douro</strong>
              </a>
               - A coastal district where the Douro River meets the Atlantic Ocean. 
               Known for its beaches, seaside promenades, cafés, restaurants, and bars. 
               One of Porto’s most scenic areas, especially at sunset and during dramatic ocean swells.
               While it isn’t a single site or monument you would typically see pinned on a map, it is an area well worth exploring. 
               I recommend setting aside an afternoon to walk from Porto’s historic center out to the Atlantic along this route. 
               I made the walk, stopping for drinks and small plates along the way, and ended the evening with dinner at a beach bar while watching a spectacular sunset. 
               It was one of the most relaxing and and the sunset was memorable (see bottom of page).
            </p>
