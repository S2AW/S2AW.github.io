---
import MainLayout2 from "../../layouts/mainlayout2.astro";

const SITE_TITLE = "Stephen — Experience";
const SITE_DESCRIPTION = "Professional roles, responsibilities, and impact.";

type Link = { label: string; href: string };

type Segment = {
  intro?: string;
  bullets?: string[];
  links?: Link[];
};

type CompanyWithSegments = {
  years: string;
  title: string;
  company: string;
  companyUrl?: string;
  location?: string;
  logo?: string;
  logoAlt?: string;
  segments: Segment[];
};

const EXPERIENCE: CompanyWithSegments[] = [
  {
    years: "Mar 2026 – Present",
    title: "Master Data Analyst",
    company: "YETI®",
    companyUrl: "https://nl.yeti.com/",
    location: "Amsterdam, Netherlands",
    logo: "/images/experience/logos/yeti.jpeg",
    logoAlt: "YETI logo",
    segments: [
      {
        intro:
          "Contracted by YETI EMEA to strengthen product and pricing master data management across ERP and B2B systems, ensuring data integrity, governance, and scalable processes to support seasonal launches and business growth:",
        bullets: [
          "Managed creation, validation, and maintenance of product and pricing master data across ERP and B2B platforms, consolidating information from multiple sources to ensure accuracy and consistency across systems;",
          "Partnered with Merchandising and Supply Planning teams to support new season launches, maintain accurate assortment files, and ensure product data was correctly transmitted to warehouses and ordering platforms;",
          "Implemented data governance and quality assurance processes, including regular data cleaning and exception-based reporting to identify and resolve inconsistencies;",
          "Supported SAP Master Data Management initiatives by contributing to system design, testing, and process improvements related to product data workflows; and",
          "Automated and streamlined data preparation and reporting processes using advanced Excel and BI tools to improve operational efficiency and data reliability across the organization."
        ],
        links: [{ label: "YETI - EMEA", href: "https://nl.yeti.com/" }]
      }
    ]
  },
  {
    years: "Mar 2022 – Jul 2024",
    title: "Strategy & Analytics Consultant",
    company: "Deloitte",
    companyUrl: "https://www.deloitte.com/na/en.html",
    location: "Washington, D.C., USA",
    logo: "/images/experience/logos/deloitte.jpeg",
    logoAlt: "Deloitte logo",
    segments: [
      {
        intro:
          "Contracted by the Department of State’s Bureau of Energy Resources to support its Energy and Mineral Governance Program in Greenland as an Economic Geologist:",
        bullets: [
          "Organized coordination between Deloitte, Department of State, Government of Greenland, and geologists to determine field targets, secure aircraft and equipment, staff teams, and ensure safety before field programs;",
          "Joined field teams in Greenland to assist with sample collection, site inspections, and sample processing as well as provide logistical support from base arranging critical supply deliveries; and",
          "Produced detailed field program reports, documenting activities, conditions, data collected, and findings for policymakers."
        ],
        links: [
          { label: "Energy and Mineral Governance Program", href: "https://www.state.gov/wp-content/uploads/2022/08/FBS_ENR_Public.pdf" }
        ]
      },
      {
        intro:
          "Contracted by the National Pollution Funds Center to enhance financial management, reporting, and internal controls for the Oil Spill Liability Trust Fund:",
        bullets: [
          "Migrated legacy spill-tracking systems into SharePoint, designing entity-relationship diagrams, applying database normalization, and using Python/Power Automate for ETL processes;",
          "Developed a PowerApps interface for controlled data entry and automated notifications; and",
          "Built Tableau and Power BI dashboards that allowed senior leadership to monitor budgets and identify financial risks across NPFC operations."
        ],
        links: [
          {
            label: "National Pollution Funds Center",
            href: "https://www.uscg.mil/Mariners/National-Pollution-Funds-Center/"
          }
        ]
      }
    ]
  },
  {
    years: "Feb 2019 – Feb 2022",
    title: "Data Analyst",
    company: "IMG-Crown",
    companyUrl: "https://www.imgcrown.com/",
    location: "Washington, D.C., USA",
    logo: "/images/experience/logos/img.jpeg",
    logoAlt: "IMG-Crown logo",
    segments: [
      {
        intro:
          "Contracted under the Department of Energy EOP-IV Omnibus Procurement to support Energy Information Administration publications, including the Monthly Oil & Gas Production Report and the Natural Gas Annual:",
        bullets: [
          "Managed monthly EIA-914 survey responses from oil and gas operators, investigated data anomalies, and contacted companies to verify data;",
          "Monitored mergers, acquisitions, and divestitures to maintain accurate operator samples, ensuring reliable state and national production estimates;",
          "Built web scrapers and maintained databases (Python, SQL) to collect and store state-level natural gas production data reporting; and",
          "Analyzed production trends and updated EIA officials, supporting publications and energy statistics used by Congress, academia, and industry."
        ],
        links: [
          { label: "EIA — Natural Gas Annual", href: "https://www.eia.gov/naturalgas/annual/" },
          { label: "Monthly Crude Oil and Natural Gas Production", href: "https://www.eia.gov/petroleum/production/" }
        ]
      }
    ]
  },
  {
    years: "Aug 2018 – Jan 2019",
    title: "Wellsite Geologist",
    company: "Columbine Logging",
    companyUrl: "https://www.columbinelogging.com/",
    location: "Denver, Colorado, USA",
    logo: "/images/experience/logos/columbine.jpeg",
    logoAlt: "Columbine Logging logo",
    segments: [
      {
        intro:
          "Subcontracted to various oil and gas operators to provide mudlogging services across basins in Wyoming and Colorado:",
        bullets: [
          "Provided 12-hour night shift coverage to drilling projects;",
          "Operated gas chromatographs to measure casinghead gas and monitored drilling parameters in real time;",
          "Collected and analyzed drill cuttings to describe formations for accurate mapping and safe drilling; and",
          "Delivered final well logs including drilling data, gas readings, and rock descriptions, to well managers."
        ],
        links: [
          {
            label: "Powder River Basin overview",
            href: "https://www.usgs.gov/centers/energy-resources-program/science/powder-river-basin"
          }
        ]
      }
    ]
  }
];
---

<MainLayout2
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  activeNav="experience"
  pageTitle="Experience"
  pageDescription="Data, Strategy & Analytics"
>
  <section class="timeline">
    <div class="exp">
      {EXPERIENCE.map((entry) => (
        <article class="exp-item">
          <div class="dot" aria-hidden="true"></div>

          <div class="card exp-card">
            {entry.logo ? (
              entry.companyUrl ? (
                <a
                  class="logo-wrap"
                  href={entry.companyUrl}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${entry.company} website`}
                >
                  <img
                    class="logo"
                    src={entry.logo}
                    alt={entry.logoAlt ?? `${entry.company} logo`}
                    width="88"
                    height="88"
                    loading="lazy"
                  />
                </a>
              ) : (
                <div class="logo-wrap">
                  <img
                    class="logo"
                    src={entry.logo}
                    alt={entry.logoAlt ?? `${entry.company} logo`}
                    width="88"
                    height="88"
                    loading="lazy"
                  />
                </div>
              )
            ) : (
              <div class="logo-wrap" aria-hidden="true"></div>
            )}

            <div class="text-col">
              <div class="years">{entry.years}</div>
              <div class="title">{entry.title}</div>

              <div class="company">
                {entry.companyUrl ? (
                  <a href={entry.companyUrl} target="_blank" rel="noopener">
                    {entry.company}
                  </a>
                ) : (
                  entry.company
                )}
                {entry.location ? ` — ` : ""}
                <span class="meta">{entry.location}</span>
              </div>

              <div class="segments">
                {entry.segments.map((s) => (
                  <div class="segment">
                    {s.intro && <p class="segment-intro">{s.intro}</p>}

                    {s.bullets && s.bullets.length > 0 && (
                      <ul class="notes">
                        {s.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    )}

                    {s.links && s.links.length > 0 && (
                      <div class="links">
                        {s.links.map((l) => (
                          <a class="chip" href={l.href} target="_blank" rel="noopener">
                            {l.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <style>
.timeline {
  position: relative;
  margin-top: 8px;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 12px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border);
}

.exp {
  display: grid;
  gap: 14px;
}

.exp-item {
  position: relative;
  padding-left: 44px;
}

.dot {
  position: absolute;
  left: 4px;
  top: 28px;
  width: 16px;
  height: 16px;
  border-radius: 999px;
  background: var(--surface);
  border: 2px solid var(--accent);
  outline: 2px solid var(--surface);
}

.exp-card {
  padding: 14px 16px;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 14px;
  align-items: start;
  background: var(--surface);
  border: 2px solid var(--card-border);
  border-radius: var(--radius-md);
}

.logo-wrap {
  width: 88px;
  height: 88px;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--surface);
  display: grid;
  place-items: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.logo {
  width: 88%;
  height: 88%;
  object-fit: contain;
  image-rendering: -webkit-optimize-contrast;
}

.text-col {
  display: grid;
  gap: 4px;
  color: var(--text);
}

.years {
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--text);
}

.title {
  font-weight: 700;
  color: var(--title);
}

.company {
  color: var(--title);
}

.company a {
  color: var(--accent);
  text-decoration: none;
}

.company a:hover {
  text-decoration: underline;
}

.meta {
  color: var(--muted);
  font-size: 0.95rem;
}

.notes {
  margin: 6px 0 0;
  padding-left: 18px;
  color: var(--text-soft);
}

.notes li {
  color: inherit;
}

.links {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* FIX: make links blue again */
.chip {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
}

.chip:hover {
  text-decoration: underline;
}

.segments {
  margin-top: 10px;
  display: grid;
  gap: 0;
}

.segment {
  padding: 12px 0;
  border-top: 1px solid var(--border);
}

.segment:first-child {
  border-top: 0;
  padding-top: 6px;
}

.segment-intro {
  margin: 0 0 6px;
  color: var(--text);
}

.segment .notes {
  margin-top: 4px;
}

.segment .links {
  margin-top: 8px;
}

@media (max-width: 900px) {
  .subtext {
    white-space: normal;
    text-overflow: clip;
    overflow: visible;
    max-width: 65ch;
    text-wrap: pretty;
  }
}

@media (max-width: 640px) {
  .logo-wrap {
    width: 72px;
    height: 72px;
  }
}
</style>
</MainLayout2>