---
import MainLayout2 from "../../layouts/mainlayout2.astro";

const SITE_TITLE = "Stephen — Projects";
const SITE_DESCRIPTION = "A showcase of my projects, ideas, and ongoing work.";
---

<MainLayout2
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  activeNav="projects"
  pageTitle="Projects"
  pageDescription="Selected work, experiments, and works-in-progress."
>
  <div class="callout" id="latest">
    <div><b>Work in progress</b></div>
    <div>
      This page is being built. The first project that will appear here is
      <b>this website</b> itself. Once the website is reasonably operational,
      it will be listed first with a full write-up.
    </div>
  </div>

  <section class="grid">
    <article class="card project-card" aria-label="Portfolio website project placeholder">
      <img
        class="thumb"
        src="/images/home/project-thumb.jpg"
        alt="Website preview placeholder"
      />

      <div class="body">
        <div class="title">This Portfolio Website</div>
        <div class="meta">Status: In progress</div>

        <p class="desc">
          I am designing a website to showcase my background, experiences,
          and interests, combining professionalism with a sense of
          personality that goes beyond a traditional resume.
        </p>
      </div>
    </article>
  </section>

  <style>
    .callout {
      border: 2px dashed var(--card-border);
      border-radius: 14px;
      background: var(--surface);
      color: var(--text);
      padding: 16px;
      display: grid;
      gap: 6px;
      max-width: 900px;
    }

    .callout b {
      color: var(--title);
    }

    .callout small {
      color: var(--muted);
    }

    .grid {
      display: grid;
      gap: 18px;
      grid-template-columns: repeat(1, 1fr);
      margin-top: 22px;
    }

    @media (min-width: 720px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (min-width: 1100px) {
      .grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .project-card {
      border: 2px solid var(--card-border);
      border-radius: 14px;
      overflow: hidden;
      background: var(--surface);
      display: flex;
      flex-direction: column;
    }

    .thumb {
      aspect-ratio: 16 / 10;
      width: 100%;
      object-fit: cover;
      background: var(--surface-muted);
    }

    .body {
      padding: 12px;
      display: grid;
      gap: 6px;
      color: var(--text);
    }

    .title {
      font-weight: 700;
      color: var(--title);
    }

    .meta {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .desc {
      color: var(--text-soft);
      font-size: 0.95rem;
      margin: 0;
    }
  </style>
</MainLayout2>