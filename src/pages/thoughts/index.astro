---
import MainLayout2 from "../../layouts/mainlayout2.astro";

const SITE_TITLE = "Stephen — Thoughts";
const SITE_DESCRIPTION = "Longer-form ideas, notes, and experiments.";

const SUBSTACK_URL = "https://s2aw.substack.com/";
const SUBSTACK_EMBED_URL = `${SUBSTACK_URL}/embed`;
---

<MainLayout2
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  activeNav="thoughts"
  pageTitle="Thoughts"
  pageDescription="Longer-form ideas, notes, and experiments. I publish them over on Substack, and you can read them directly here or open them in a new tab."
  wideHeader={true}
>
  <div class="cta-row">
    <a
      href={SUBSTACK_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn primary"
    >
      View on Substack
    </a>
    <a
      href={`${SUBSTACK_URL}/subscribe`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn secondary"
    >
      Subscribe via email
    </a>
  </div>

  <section class="embed-wrap">
    <div class="embed-inner">
      <iframe
        src={SUBSTACK_EMBED_URL}
        loading="lazy"
        class="embed-frame"
        title="Substack – Thoughts"
      ></iframe>
    </div>
  </section>

  <style>
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-top: 0.75rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.6rem 1.3rem;
      border-radius: 999px;
      text-decoration: none;
      border: 1px solid currentColor;
      font-size: 0.95rem;
      white-space: nowrap;
      transition:
        background-color var(--transition-fast),
        color var(--transition-fast),
        border-color var(--transition-fast),
        box-shadow var(--transition-fast);
    }

    .btn.primary {
      border: 1px solid var(--card-border);
      color: var(--surface);
      background: var(--title);
    }

    .btn.secondary {
      color: var(--title);
      background: var(--surface-muted);
      border-color: var(--border);
    }

    .embed-wrap {
      margin-top: 10px;
      background: linear-gradient(180deg, var(--surface-muted), var(--surface));
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 12px;
      position: relative;
      min-height: 400px;
      overflow: hidden;
    }

    .embed-inner {
      border-radius: 12px;
      background: var(--surface);
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .embed-frame {
      width: 100%;
      height: 95vh;
      min-height: 520px;
      border: none;
      display: block;
    }

    @media (max-width: 600px) {
      .cta-row {
        flex-direction: column;
        align-items: flex-start;
      }

      .embed-frame {
        height: 70vh;
        min-height: 450px;
      }
    }
  </style>
</MainLayout2>