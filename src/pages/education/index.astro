---
import MainLayout2 from "../../layouts/mainlayout2.astro";

const SITE_TITLE = "Stephen — Education";
const SITE_DESCRIPTION = "Degrees, programs, and academic focus areas.";

type Edu = {
  years: string;
  school: string;
  location?: string;
  degree?: string;
  notes?: string[];
  links?: { label: string; href: string }[];
  logo?: string;
  logoAlt?: string;
};

const EDUCATION: Edu[] = [
  {
    years: "2024–2025",
    school: "Vrije Universiteit Amsterdam (VU Amsterdam)",
    location: "Amsterdam, Netherlands",
    degree: "MSc — Spatial and Applied Economics",
    notes: [
      "Tracks: Transport & Network Economics; Environmental Economics",
      "Thesis: Optimal Targets for Network Disruption in Military Conflicts"
    ],
    links: [
      { label: "Program overview", href: "https://vu.nl/en/education/master/spatial-and-applied-economics" },
      { label: "Transport & Network Economics", href: "https://vu.nl/en/education/master/transport-and-network-economics" },
      { label: "Environmental Economics", href: "https://vu.nl/en/education/master/environmental-economics" }
    ],
    logo: "/images/education/logos/vu.jpg",
    logoAlt: "Vrije Universiteit Amsterdam logo"
  },
  {
    years: "2014–2018",
    school: "Penn State University",
    location: "State College, PA, USA",
    degree: "B.S. — Geosciences",
    notes: [
      "Broad foundation in physical & natural sciences"
    ],
    links: [
      { label: "Geosciences B.S.", href: "https://bulletins.psu.edu/undergraduate/colleges/earth-mineral-sciences/geosciences-bs/" }
    ],
    logo: "/images/education/logos/psu.jpg",
    logoAlt: "Penn State University logo"
  },
  {
    years: "2010–2014",
    school: "Upper Dublin High School",
    location: "Fort Washington, PA, USA",
    degree: "High School Diploma",
    links: [
      { label: "About Upper Dublin HS", href: "https://www.udsd.org/o/udhs" }
    ],
    logo: "/images/education/logos/udhs.jpg",
    logoAlt: "Upper Dublin High School logo"
  }
];
---

<MainLayout2
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  activeNav="education"
  pageTitle="Education"
  pageDescription="MSc Economics | BSc Geosciences"
>
  <section class="timeline">
    <div class="edu">
      {EDUCATION.map((e) => (
        <article class="edu-item">
          <div class="dot" aria-hidden="true"></div>

          <div class="card edu-card">
            {e.logo && (
              <div class="logo-wrap">
                <img
                  class="logo"
                  src={e.logo}
                  alt={e.logoAlt ?? `${e.school} logo`}
                  width="88"
                  height="88"
                  loading="lazy"
                />
              </div>
            )}

            <div class="text-col">
              <div class="years">{e.years}</div>
              <div class="school">{e.school}</div>
              {e.location && <div class="meta">{e.location}</div>}
              {e.degree && <div class="degree">{e.degree}</div>}

              {e.notes && e.notes.length > 0 && (
                <ul class="notes">
                  {e.notes.map((n) => <li>{n}</li>)}
                </ul>
              )}

              {e.links && e.links.length > 0 && (
                <div class="links">
                  {e.links.map((l) => (
                    <a class="chip" href={l.href} target="_blank" rel="noopener">
                      {l.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <style>
.timeline {
  position: relative;
  margin-top: 8px;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 12px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border);
}

.edu {
  display: grid;
  gap: 14px;
}

.edu-item {
  position: relative;
  padding-left: 44px;
}

.dot {
  position: absolute;
  left: 4px;
  top: 28px;
  width: 16px;
  height: 16px;
  border-radius: 999px;
  background: var(--surface);
  border: 2px solid var(--accent);
  outline: 2px solid var(--surface);
}

.edu-card {
  padding: 14px 16px;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 14px;
  align-items: start;
  background: var(--surface);
  border: 2px solid var(--card-border);
  border-radius: var(--radius-md);
}

.logo-wrap {
  width: 88px;
  height: 88px;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--surface);
  display: grid;
  place-items: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.logo {
  width: 88%;
  height: 88%;
  object-fit: contain;
  image-rendering: -webkit-optimize-contrast;
}

.text-col {
  display: grid;
  gap: 4px;
  color: var(--text);
}

.years {
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--text);
}

.school {
  font-weight: 700;
  color: var(--title);
}

.meta {
  color: var(--muted);
  font-size: 0.95rem;
}

.degree {
  font-weight: 600;
  margin-top: 2px;
  color: var(--text);
}

.notes {
  margin: 6px 0 0;
  padding-left: 18px;
  color: var(--text-soft);
}

.notes li {
  color: inherit;
}

.links {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* FIX: make program links blue like hyperlinks */
.chip {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
}

.chip:hover {
  text-decoration: underline;
}

@media (max-width: 640px) {
  .logo-wrap {
    width: 72px;
    height: 72px;
  }
}
</style>
</MainLayout2>